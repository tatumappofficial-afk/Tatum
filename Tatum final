<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tatum — Telling A Truth Uniquely Mine</title>
<meta name="description" content="Tatum is a private intimacy tracker for women. Your story. Your proof. Your power. Available on iOS and Android.">
<meta name="keywords" content="intimacy tracker, women's wellness, private app, relationship tracking, women empowerment">
<meta property="og:title" content="Tatum — Your Story. Your Proof. Your Power.">
<meta property="og:description" content="A private intimacy tracker built for women. No accounts. No cloud. Only yours.">
<meta property="og:url" content="https://tatumapp.com">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════
   RESET & ROOT
═══════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --sand:    #F5EFE8;
  --cream:   #FBF7F2;
  --surface: #EDE3D8;
  --fig:     #7C4A5A;
  --fig2:    #5A3040;
  --mauve:   #B07080;
  --terra:   #C07858;
  --gold:    #C4993A;
  --blush:   #E8C4B0;
  --sage:    #8BA888;
  --ink:     #3D2B25;
  --muted:   #A08878;
  --stone:   #9A8878;
}

html { scroll-behavior: smooth; }

body {
  background: var(--cream);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
  line-height: 1.7;
  overflow-x: hidden;
}

/* ═══════════════════════════════════════════
   BLOOM SVG COMPONENT
═══════════════════════════════════════════ */
.bloom-svg { display: block; }

/* ═══════════════════════════════════════════
   NAV
═══════════════════════════════════════════ */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 48px;
  background: rgba(251,247,242,0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(192,120,88,0.1);
  transition: all 0.3s ease;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}
.nav-wordmark {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 6px;
  color: var(--terra);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 36px;
  list-style: none;
}
.nav-links a {
  font-size: 12px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s;
  font-weight: 400;
}
.nav-links a:hover { color: var(--terra); }

.nav-cta {
  background: var(--fig);
  color: #FBF7F2 !important;
  padding: 10px 24px;
  border-radius: 50px;
  font-size: 11px !important;
  letter-spacing: 2px !important;
  transition: background 0.2s !important;
}
.nav-cta:hover { background: var(--fig2) !important; color: #FBF7F2 !important; }

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 120px 48px 80px;
  background: linear-gradient(160deg, #FBF7F2 0%, #F5EFE8 50%, #EDE3D8 100%);
}

/* Atmospheric rings */
.hero::before {
  content: '';
  position: absolute;
  top: -200px; right: -200px;
  width: 700px; height: 700px;
  border-radius: 50%;
  border: 1px solid rgba(192,120,88,0.1);
  pointer-events: none;
}
.hero::after {
  content: '';
  position: absolute;
  bottom: -150px; left: -150px;
  width: 500px; height: 500px;
  border-radius: 50%;
  border: 1px solid rgba(196,153,58,0.08);
  pointer-events: none;
}

.hero-inner {
  max-width: 1100px;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.hero-text { position: relative; z-index: 1; }

.hero-eyebrow {
  font-size: 11px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--terra);
  font-weight: 500;
  margin-bottom: 20px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.2s forwards;
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(48px, 6vw, 72px);
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
  margin-bottom: 24px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.4s forwards;
}
.hero-title em {
  font-style: italic;
  color: var(--fig);
}

.hero-sub {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-style: italic;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 40px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.6s forwards;
}

.hero-tagline {
  font-size: 13px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--stone);
  font-weight: 300;
  margin-bottom: 48px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.7s forwards;
}

.hero-buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.9s forwards;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--fig);
  color: #FBF7F2;
  padding: 16px 36px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-decoration: none;
  transition: all 0.25s;
  box-shadow: 0 8px 28px rgba(124,74,90,0.3);
}
.btn-primary:hover {
  background: var(--fig2);
  transform: translateY(-2px);
  box-shadow: 0 12px 36px rgba(124,74,90,0.4);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: transparent;
  color: var(--terra);
  padding: 16px 36px;
  border-radius: 50px;
  border: 1px solid rgba(192,120,88,0.35);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 1.5px;
  text-decoration: none;
  transition: all 0.25s;
}
.btn-secondary:hover {
  background: rgba(192,120,88,0.06);
  border-color: var(--terra);
  transform: translateY(-2px);
}

.hero-bloom {
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  animation: fadeIn 1.2s ease 0.5s forwards;
}

.price-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(196,153,58,0.12);
  border: 1px solid rgba(196,153,58,0.3);
  border-radius: 50px;
  padding: 8px 20px;
  font-size: 12px;
  color: var(--gold);
  letter-spacing: 1px;
  margin-bottom: 32px;
  font-weight: 500;
}

/* ═══════════════════════════════════════════
   SECTION SHARED
═══════════════════════════════════════════ */
section { padding: 100px 48px; }

.section-inner {
  max-width: 1100px;
  margin: 0 auto;
}

.section-tag {
  font-size: 10px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--terra);
  font-weight: 500;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.section-tag::after {
  content: '';
  flex: 0 0 40px;
  height: 1px;
  background: var(--terra);
  opacity: 0.4;
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 4vw, 52px);
  font-weight: 700;
  line-height: 1.15;
  color: var(--ink);
  margin-bottom: 20px;
}
.section-title em {
  font-style: italic;
  color: var(--fig);
}

.section-body {
  font-size: 17px;
  color: var(--muted);
  line-height: 1.85;
  max-width: 560px;
}

/* ═══════════════════════════════════════════
   PULL QUOTE
═══════════════════════════════════════════ */
.pull-quote-section {
  background: var(--fig);
  padding: 80px 48px;
}
.pull-quote {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}
.pull-quote p {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 4vw, 48px);
  font-style: italic;
  color: #F5EFE8;
  line-height: 1.5;
  margin-bottom: 24px;
}
.pull-quote cite {
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--blush);
  opacity: 0.65;
  font-style: normal;
}

/* ═══════════════════════════════════════════
   ORIGIN STORY
═══════════════════════════════════════════ */
.origin {
  background: var(--sand);
}
.origin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.origin-text p {
  font-size: 17px;
  color: var(--ink);
  line-height: 1.9;
  margin-bottom: 20px;
  font-family: 'Playfair Display', serif;
  font-style: italic;
}
.origin-text p strong {
  font-style: normal;
  color: var(--fig);
  font-weight: 600;
}
.origin-bloom {
  display: flex;
  justify-content: center;
}
.notebook-card {
  background: var(--cream);
  border-radius: 20px;
  padding: 40px;
  border: 1px solid rgba(192,120,88,0.18);
  box-shadow: 0 8px 40px rgba(61,43,37,0.08);
  position: relative;
  overflow: hidden;
}
.notebook-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 6px; height: 100%;
  background: linear-gradient(to bottom, var(--terra), var(--fig));
  border-radius: 20px 0 0 20px;
}
.notebook-title {
  font-family: 'Playfair Display', serif;
  font-size: 14px;
  letter-spacing: 3px;
  color: var(--stone);
  text-transform: uppercase;
  margin-bottom: 24px;
  padding-left: 20px;
}
.notebook-entry {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 20px;
  border-bottom: 1px solid rgba(192,120,88,0.1);
  font-family: 'Playfair Display', serif;
}
.notebook-date {
  font-size: 13px;
  color: var(--muted);
  min-width: 80px;
}
.notebook-initial {
  font-size: 20px;
  color: var(--terra);
  font-weight: 600;
  min-width: 32px;
}
.notebook-dot {
  font-size: 18px;
}

/* ═══════════════════════════════════════════
   FEATURES
═══════════════════════════════════════════ */
.features { background: var(--cream); }
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  margin-top: 60px;
}
.feature-card {
  background: var(--sand);
  border-radius: 20px;
  padding: 40px 32px;
  border: 1px solid rgba(192,120,88,0.14);
  transition: all 0.3s ease;
}
.feature-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 48px rgba(61,43,37,0.1);
  border-color: rgba(192,120,88,0.3);
}
.feature-icon {
  font-size: 36px;
  margin-bottom: 20px;
  display: block;
}
.feature-title {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12px;
}
.feature-body {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.8;
}

/* ═══════════════════════════════════════════
   PRIVACY PROMISE
═══════════════════════════════════════════ */
.privacy { background: var(--ink); }
.privacy .section-tag { color: var(--blush); }
.privacy .section-tag::after { background: var(--blush); }
.privacy .section-title { color: #F5EFE8; }
.privacy .section-title em { color: var(--blush); }
.privacy .section-body { color: rgba(232,196,176,0.7); }

.privacy-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 56px;
}
.privacy-item {
  background: rgba(245,239,232,0.06);
  border: 1px solid rgba(245,239,232,0.1);
  border-radius: 16px;
  padding: 32px 28px;
}
.privacy-item-icon {
  font-size: 28px;
  margin-bottom: 16px;
  display: block;
}
.privacy-item-title {
  font-family: 'Playfair Display', serif;
  font-size: 17px;
  font-weight: 600;
  color: #F5EFE8;
  margin-bottom: 10px;
}
.privacy-item-body {
  font-size: 14px;
  color: rgba(232,196,176,0.65);
  line-height: 1.75;
}

/* ═══════════════════════════════════════════
   FOR HER — WHO TATUM IS FOR
═══════════════════════════════════════════ */
.for-her { background: var(--sand); }
.for-her-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 56px;
}
.her-card {
  background: var(--cream);
  border-radius: 16px;
  padding: 32px;
  border: 1px solid rgba(192,120,88,0.14);
  display: flex;
  gap: 20px;
  align-items: flex-start;
  transition: all 0.25s;
}
.her-card:hover { border-color: var(--mauve); }
.her-emoji { font-size: 28px; flex-shrink: 0; margin-top: 2px; }
.her-content {}
.her-title {
  font-family: 'Playfair Display', serif;
  font-size: 17px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8px;
}
.her-body {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.75;
}

/* ═══════════════════════════════════════════
   PRICING
═══════════════════════════════════════════ */
.pricing { background: var(--cream); }
.pricing-card {
  max-width: 520px;
  margin: 56px auto 0;
  background: var(--sand);
  border-radius: 28px;
  padding: 56px 48px;
  border: 1px solid rgba(192,120,88,0.2);
  text-align: center;
  box-shadow: 0 16px 60px rgba(61,43,37,0.1);
  position: relative;
  overflow: hidden;
}
.pricing-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--terra), var(--fig), var(--gold));
}
.pricing-label {
  font-size: 11px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--terra);
  font-weight: 500;
  margin-bottom: 20px;
}
.pricing-price {
  font-family: 'Playfair Display', serif;
  font-size: 80px;
  font-weight: 700;
  color: var(--fig);
  line-height: 1;
  margin-bottom: 4px;
}
.pricing-price sup {
  font-size: 36px;
  vertical-align: super;
}
.pricing-period {
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 36px;
  font-style: italic;
  font-family: 'Playfair Display', serif;
}
.pricing-features {
  list-style: none;
  margin-bottom: 40px;
  text-align: left;
}
.pricing-features li {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(192,120,88,0.1);
  font-size: 15px;
  color: var(--ink);
}
.pricing-features li:last-child { border-bottom: none; }
.pricing-check {
  color: var(--terra);
  font-size: 14px;
  flex-shrink: 0;
}
.pricing-btn {
  display: block;
  width: 100%;
  background: var(--fig);
  color: #F5EFE8;
  padding: 18px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 2px;
  text-decoration: none;
  transition: all 0.25s;
  box-shadow: 0 8px 28px rgba(124,74,90,0.3);
  margin-bottom: 16px;
}
.pricing-btn:hover {
  background: var(--fig2);
  transform: translateY(-2px);
}
.pricing-note {
  font-size: 12px;
  color: var(--stone);
  letter-spacing: 0.5px;
}

/* ═══════════════════════════════════════════
   FOUNDER
═══════════════════════════════════════════ */
.founder {
  background: linear-gradient(160deg, var(--fig) 0%, var(--fig2) 100%);
  padding: 100px 48px;
}
.founder-inner {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}
.founder-bloom {
  margin: 0 auto 40px;
}
.founder-tag {
  font-size: 11px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--blush);
  opacity: 0.6;
  margin-bottom: 20px;
}
.founder-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 4vw, 42px);
  font-style: italic;
  color: #F5EFE8;
  line-height: 1.5;
  margin-bottom: 32px;
}
.founder-body {
  font-size: 16px;
  color: rgba(232,196,176,0.8);
  line-height: 1.9;
  margin-bottom: 20px;
  font-family: 'Playfair Display', serif;
  font-style: italic;
}
.founder-sig {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  color: var(--blush);
  margin-top: 40px;
}
.founder-sig-title {
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(232,196,176,0.5);
  margin-top: 6px;
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
}

/* ═══════════════════════════════════════════
   CTA FOOTER SECTION
═══════════════════════════════════════════ */
.cta-section {
  background: var(--sand);
  text-align: center;
  padding: 120px 48px;
}
.cta-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 5vw, 60px);
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16px;
  line-height: 1.15;
}
.cta-title em { font-style: italic; color: var(--fig); }
.cta-sub {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-style: italic;
  color: var(--muted);
  margin-bottom: 48px;
}
.cta-buttons {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ═══════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════ */
footer {
  background: var(--ink);
  padding: 60px 48px 40px;
}
.footer-inner {
  max-width: 1100px;
  margin: 0 auto;
}
.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 60px;
  padding-bottom: 48px;
  border-bottom: 1px solid rgba(245,239,232,0.1);
  margin-bottom: 32px;
}
.footer-brand-name {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: 6px;
  color: var(--terra);
  margin-bottom: 8px;
}
.footer-tagline {
  font-size: 12px;
  letter-spacing: 2px;
  color: rgba(232,196,176,0.5);
  font-style: italic;
  margin-bottom: 20px;
  font-family: 'Playfair Display', serif;
}
.footer-desc {
  font-size: 14px;
  color: rgba(232,196,176,0.55);
  line-height: 1.8;
  max-width: 280px;
}
.footer-col-title {
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--blush);
  opacity: 0.6;
  margin-bottom: 20px;
  font-weight: 500;
}
.footer-links { list-style: none; }
.footer-links li { margin-bottom: 12px; }
.footer-links a {
  font-size: 14px;
  color: rgba(232,196,176,0.55);
  text-decoration: none;
  transition: color 0.2s;
}
.footer-links a:hover { color: var(--blush); }
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}
.footer-copy {
  font-size: 12px;
  color: rgba(232,196,176,0.3);
  letter-spacing: 0.5px;
}
.footer-social {
  display: flex;
  gap: 20px;
}
.footer-social a {
  font-size: 12px;
  letter-spacing: 1.5px;
  color: rgba(232,196,176,0.4);
  text-decoration: none;
  text-transform: uppercase;
  transition: color 0.2s;
}
.footer-social a:hover { color: var(--blush); }

/* ═══════════════════════════════════════════
   ANIMATIONS
═══════════════════════════════════════════ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-16px); }
}
.hero-bloom svg { animation: float 6s ease-in-out infinite; }

